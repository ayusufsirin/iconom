COMPOSE_PROJECT_NAME=iconom

# Canonical single-vehicle defaults
ICONOM_VEHICLE_NAMESPACE=plane_01
PX4_GIT_REF=v1.16.0
PX4_HEADLESS=1
PX4_SYS_AUTOSTART=4003
PX4_GZ_WORLD=default
PX4_UXRCE_DDS_HOST=xrce_agent
PX4_UXRCE_DDS_NS=plane_01
PX4_SIM_MODEL=gz_rc_cessna
PX4_INSTANCE=0
UXRCE_DDS_KEY=1
ICONOM_GZ_MODEL_NAME=rc_cessna_0
ICONOM_EXPECTED_MAV_SYS_ID=1
ICONOM_EXPECTED_MAVLINK_OFFBOARD_PORT=14540
ICONOM_EXPECTED_UXRCE_DDS_KEY=1
PX4_GZ_MODEL_POSE=0,0,0

# Phase-4 explicit dual-aircraft contract
PLANE_01_NAMESPACE=plane_01
PLANE_02_NAMESPACE=plane_02
PLANE_01_PX4_UXRCE_DDS_NS=plane_01
PLANE_02_PX4_UXRCE_DDS_NS=plane_02
PLANE_01_PX4_INSTANCE=0
PLANE_02_PX4_INSTANCE=1
PLANE_01_UXRCE_DDS_KEY=1
PLANE_02_UXRCE_DDS_KEY=2
PLANE_01_MAV_SYS_ID=1
PLANE_02_MAV_SYS_ID=2
PLANE_01_MAVLINK_OFFBOARD_PORT=14540
PLANE_02_MAVLINK_OFFBOARD_PORT=14541
PLANE_02_EXPECTED_UXRCE_DDS_KEY=2
PLANE_01_GZ_MODEL_NAME=rc_cessna_0
PLANE_02_GZ_MODEL_NAME=rc_cessna_1
PLANE_01_PX4_GZ_MODEL_POSE=0,0,0
PLANE_02_PX4_GZ_MODEL_POSE=0,15,0
PLANE_01_CAMERA_TOPIC=/plane_01/camera/image_raw
PLANE_01_CAMERA_INFO_TOPIC=/plane_01/camera/camera_info
PLANE_02_CAMERA_TOPIC=/plane_02/camera/image_raw
PLANE_02_CAMERA_INFO_TOPIC=/plane_02/camera/camera_info
PLANE_01_GZ_IMAGE_TOPIC=/world/default/model/rc_cessna_0/link/camera_link/sensor/imager/image
PLANE_01_GZ_CAMERA_INFO_TOPIC=/world/default/model/rc_cessna_0/link/camera_link/sensor/imager/camera_info
PLANE_02_GZ_IMAGE_TOPIC=/world/default/model/rc_cessna_1/link/camera_link/sensor/imager/image
PLANE_02_GZ_CAMERA_INFO_TOPIC=/world/default/model/rc_cessna_1/link/camera_link/sensor/imager/camera_info

# Transport and topic defaults
XRCE_AGENT_UDP_PORT=8888
XRCE_AGENT_VERSION=v2.4.3
MAVLINK_OFFBOARD_BASE_PORT=14540
MAVLINK_GCS_PORT=14550
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
USE_SIM_TIME=true
CAMERA_TOPIC=/plane_01/camera/image_raw
CAMERA_INFO_TOPIC=/plane_01/camera/camera_info
GZ_IMAGE_TOPIC=/world/default/model/rc_cessna_0/link/camera_link/sensor/imager/image
GZ_CAMERA_INFO_TOPIC=/world/default/model/rc_cessna_0/link/camera_link/sensor/imager/camera_info
PX4_TELEMETRY_TOPIC=/plane_01/fmu/out/vehicle_status_v1
PX4_TELEMETRY_TOPIC_PREFIX=/plane_01/fmu/out
PX4_COMMAND_TOPIC=/plane_01/fmu/in/vehicle_command
PX4_COMMAND_ACK_TOPIC=/plane_01/fmu/out/vehicle_command_ack
PX4_COMMAND_NAME=disarm
PX4_NAV_COMMAND_NAME=nav_takeoff
PX4_VEHICLE_STATUS_TOPIC=/plane_01/fmu/out/vehicle_status_v1
PX4_LOCAL_POSITION_TOPIC=/plane_01/fmu/out/vehicle_local_position
PX4_GLOBAL_POSITION_TOPIC=/plane_01/fmu/out/vehicle_global_position
PX4_LAND_DETECTED_TOPIC=/plane_01/fmu/out/vehicle_land_detected
PX4_OFFBOARD_CONTROL_MODE_TOPIC=/plane_01/fmu/in/offboard_control_mode
PX4_TRAJECTORY_SETPOINT_TOPIC=/plane_01/fmu/in/trajectory_setpoint
PX4_VEHICLE_RATES_SETPOINT_TOPIC=/plane_01/fmu/in/vehicle_rates_setpoint
PX4_OFFBOARD_DELTA_X=0.0
PX4_OFFBOARD_DELTA_Y=0.0
PX4_OFFBOARD_DELTA_Z=0.0
PX4_TARGET_OFFSET_NORTH_M=0.0
PX4_TARGET_OFFSET_EAST_M=0.0
PX4_TARGET_OFFSET_ALT_M=30.0
PX4_LOITER_RADIUS_M=60.0
PX4_GROUNDSPEED_M_S=20.0
PX4_EXPECTED_LOITER_NAV_STATE=4
PX4_EXPECTED_LOITER_MIN_DELTA_XY_NORM=5.0
PX4_REPOSITION_OFFSET_NORTH_M=200.0
PX4_REPOSITION_OFFSET_EAST_M=80.0
PX4_REPOSITION_OFFSET_ALT_M=0.0
PX4_REPOSITION_HORIZONTAL_TOLERANCE_M=90.0
PX4_REPOSITION_ALT_TOLERANCE_M=40.0
PX4_ROUTE_POINT1_OFFSET_NORTH_M=200.0
PX4_ROUTE_POINT1_OFFSET_EAST_M=80.0
PX4_ROUTE_POINT1_OFFSET_ALT_M=0.0
PX4_ROUTE_POINT2_OFFSET_NORTH_M=-140.0
PX4_ROUTE_POINT2_OFFSET_EAST_M=220.0
PX4_ROUTE_POINT2_OFFSET_ALT_M=0.0
PX4_ROUTE_HORIZONTAL_TOLERANCE_M=90.0
PX4_ROUTE_ALT_TOLERANCE_M=40.0
PX4_EXPECTED_LAND_NAV_STATE=18
PX4_EXPECTED_LAND_MIN_DELTA_Z=10.0
PX4_LAND_DETECTED_TIMEOUT_SEC=120

# Phase-2 standalone Gazebo defaults
GZ_SIM_RESOURCE_PATH=/opt/iconom/sim:/opt/PX4-Autopilot/Tools/simulation/gz/models:/opt/PX4-Autopilot/Tools/simulation/gz/worlds
GAZEBO_WORLD_FILE=/opt/PX4-Autopilot/Tools/simulation/gz/worlds/default.sdf
